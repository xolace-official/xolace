# EAS Build upload rules for the whole monorepo.
#
# EAS CLI reads this file from the git root (`git rev-parse --show-toplevel`),
# not from apps/mobile, and when it exists every .gitignore is ignored. So it
# repeats the .gitignore rules that matter, and it deliberately does NOT list
# the mobile build secrets (apps/mobile/google-services.json,
# apps/mobile/google-services-preview/, apps/mobile/xolace-*.json): they are
# gitignored but the build needs them until they move to EAS file env vars.
# node_modules and .git are always excluded by EAS CLI.

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs and caches
dist/
build/
web-build/
*.tsbuildinfo
.turbo/
.nx/
.cache/
.expo/
expo-env.d.ts
.metro-health-check*
coverage/
.nyc_output/
tmp/
temp/
*.tgz
*.log
logs/
.evlog/

# Local env files: EAS builds read EAS environment variables instead
.env
.env*.local

# Generated native projects (EAS runs prebuild itself)
apps/mobile/ios/
apps/mobile/android/
**/ios/Pods/
.kotlin/

# Signing material and keys that the build does not need
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.aab
*firebase-adminsdk*.json

# Other apps' build output (their sources stay so the workspace lockfile installs)
apps/web/.next/
apps/web/out/
apps/admin/.next/
apps/docs/.next/
apps/docs/.source/
apps/desktop/src-tauri/target/
src-tauri/target/
.vercel/
.alchemy/
local.db
local.db-*

# Backend ingestion scripts and their local media (not part of the app build)
packages/backend/scripts/kindling/
packages/backend/scripts/library/

# Agent and editor local state
.claude/
.argent/
apps/mobile/.argent/
.heroui-docs/
.stream/
.gstack/
.ds-sync/
ds-bundle/
.design-sync/
.idea/
.vscode/
.DS_Store
*.swp
*.swo
*~
