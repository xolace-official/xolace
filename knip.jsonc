{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/mobile": {
      // Entry files' exports count too: an unused export in a route or a
      // config file is still dead code.
      "includeEntryExports": true,
      "entry": [
        // Permanent: each feature's dev states, found by `require.context` in
        // src/dev/discovered.ts, which knip can't follow.
        "src/features/**/dev/states.tsx",
        // The redesign's shared kit (F5) lands before the screens that use it.
        // Each file is an entry until its first screen PR imports it: delete its
        // line then. These lines only shrink. Their exports carry `@public`.
        "src/components/settings-kit/name-dialog.tsx",
        "src/components/settings-kit/open-row.tsx",
        "src/components/settings-kit/parts.tsx",
        "src/components/settings-kit/switch-row.tsx",
        "src/components/settings-kit/tile-row.tsx",
        "src/components/shared/aura.tsx",
        "src/components/shared/avatar.tsx",
        "src/components/shared/care-row.tsx",
        "src/components/shared/country-menu.tsx",
        "src/components/shared/detached-sheet.tsx",
        "src/components/shared/media-row.tsx",
        "src/components/shared/rolling-number.tsx",
        "src/lib/keyboard/keyboard-spacer.tsx",
        "src/lib/keyboard/use-keyboard-shown.ts"
      ],
      // Read by @expo/fingerprint, and by path from metro.config.js: their
      // exports are consumed by tools knip can't follow.
      "ignore": ["fingerprint.config.js", "metro-stubs/**"],
      // A props or state type exported beside its component is that
      // component's API, even before another file imports it.
      "ignoreExportsUsedInFile": { "interface": true, "type": true },
      // Component kits whose barrels export a full API (props types, hooks)
      // ahead of the app using all of it. Unused files there still count.
      "ignoreIssues": {
        "src/components/ui/**": ["exports", "types"]
      },
      "ignoreDependencies": [
        // Peer dependencies of stream-chat-react-native-core (stream-chat-expo).
        "@op-engineering/op-sqlite",
        "@react-native-community/netinfo",
        "react-native-teleport",
        // Turned on with EXPO_ATLAS=1; never imported.
        "expo-atlas",
        // Native module with no JS import. Removing it changes the native
        // fingerprint, so it goes out with the next store build.
        "react-native-purchases-ui",
        // The store review prompt left with the old session end (S3); its new
        // place is undecided. A native module: removing it changes the
        // fingerprint, so it goes with the next store build if nothing asks.
        "expo-store-review"
      ]
    }
  }
}
