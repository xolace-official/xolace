{
  "name": "xolace",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@edge-runtime/vm": "^5.0.0",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/node": "^26.6.4",
      "@types/react": "~19.3.0",
      "@types/react-dom": "~19.3.0",
      "ai": "^7.0.148",
      "convex": "^1.47.0",
      "convex-test": "0.0.56",
      "lucide-react": "^1.50.0",
      "next": "16.3.8",
      "next-themes": "^0.4.6",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "typescript": "~6.0.3",
      "varlock": "1.18.0",
      "vitest": "^4.1.11",
      "zod": "^4.6.5"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check:changed": "bun scripts/check-changed.ts",
    "check-types": "turbo run check-types",
    "codegen": "turbo run codegen",
    "deploy": "bunx vercel deploy",
    "deploy:check": "bunx vercel deploy --dry",
    "deploy:prod": "bunx vercel deploy --prod",
    "deploy:setup": "bunx vercel link",
    "dev": "turbo run dev",
    "dev:admin": "turbo run dev -F @xolace/admin --",
    "dev:cli": "turbo run dev -F @xolace/cli --",
    "dev:desktop": "turbo run dev -F @xolace/desktop --",
    "dev:docs": "turbo run dev -F @xolace/docs --",
    "dev:mobile": "turbo run dev -F @xolace/mobile --",
    "dev:server": "turbo run dev -F @xolace/backend --",
    "dev:setup": "turbo run dev:setup -F @xolace/backend --",
    "dev:vercel": "bunx vercel dev -L",
    "dev:web": "turbo run dev -F @xolace/web --",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "fix": "ultracite fix",
    "lint": "turbo run lint",
    "prepare": "husky",
    "setup:worktree": "bun scripts/setup-worktree.ts",
    "test": "turbo run test"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "catalog:",
    "@xolace/config": "workspace:*",
    "husky": "9.1.7",
    "tsx": "^4.23.13",
    "turbo": "^2.11.9",
    "typescript": "catalog:",
    "ultracite": "8.0.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "patchedDependencies": {
    "@react-native-masked-view/masked-view@0.3.2": "patches/@react-native-masked-view%2Fmasked-view@0.3.2.patch",
    "uniwind@1.11.0": "patches/uniwind@1.11.0.patch"
  },
  "trustedDependencies": [
    "@clerk/shared",
    "@sentry/cli",
    "@shopify/react-native-skia",
    "browser-tabs-lock",
    "bufferutil",
    "core-js",
    "esbuild",
    "react-native-enriched-markdown",
    "stream-chat",
    "unrs-resolver",
    "utf-8-validate"
  ]
}
