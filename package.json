{
  "name": "xolace",
  "main": "expo-router/entry",
  "version": "1.11.0",
  "expo": {
    "install": {
      "// exclude": "@shopify/react-native-skia held at 2.11.x (SDK 57 bundles 2.6.2). 2.11.1 is same major, bug-fix + additive only, Skia m152; all peers satisfied (react 19.2, RN 0.86, reanimated 4.5, worklets 0.10). Remove when SDK bump catches up.",
      "exclude": [
        "@shopify/react-native-skia"
      ]
    },
    "autolinking": {
      "// buildFromSource": "expo-image-manipulator@57.0.6's prebuilt xcframework was compiled against an older ExpoModulesCore ABI (AnyModule._decorateModule(object:in:), 2-arg) and dyld-crashes at launch against core 57.0.3 (3-arg, +appContext). Build it from source until the upstream prebuilt is rebuilt.",
      "buildFromSource": [
        "expo-image-manipulator"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:dev": "APP_VARIANT=development expo run:android",
    "android:preview": "APP_VARIANT=preview expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "APP_VARIANT=development expo run:ios",
    "ios:preview": "APP_VARIANT=preview expo run:ios",
    "prebuild:dev": "APP_VARIANT=development expo prebuild --clean",
    "prebuild:preview": "APP_VARIANT=preview expo prebuild --clean",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "vitest run --exclude '**/*.eval.test.ts'",
    "test:watch": "vitest --exclude '**/*.eval.test.ts'",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --exclude '**/*.eval.test.ts'",
    "test:coverage": "vitest run --coverage --exclude '**/*.eval.test.ts'",
    "test:evals": "RUN_EVALS=1 vitest run --testTimeout 30000 convex/ai/prompts/__evals__",
    "test:evals:intensity": "RUN_EVALS=1 vitest run --testTimeout 30000 convex/ai/prompts/__evals__/intensity.eval.test.ts",
    "stream:webhook": "convex run streamWebhook:registerWebhook",
    "stream:webhook:prod": "convex run --prod streamWebhook:registerWebhook",
    "stream:setup": "convex run streamSetup:setup",
    "stream:setup:prod": "convex run --prod streamSetup:setup",
    "kindling:hashes": "node scripts/kindling/ingest.ts --update-hashes",
    "kindling:ingest": "node scripts/kindling/ingest.ts",
    "kindling:ingest:prod": "node scripts/kindling/ingest.ts --prod"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.80",
