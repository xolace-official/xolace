# Names only. Copy to .env (Bun loads it from the directory you run in).
# All three are public values. See docs/setup/oauth-clients.md.

# Clerk frontend API, same as the backend's CLERK_JWT_ISSUER_DOMAIN
XOLACE_CLERK_ISSUER=

# Client ID of the Clerk OAuth app, same as the backend's CLERK_OAUTH_CLIENT_ID
XOLACE_CLERK_OAUTH_CLIENT_ID=

# Your own dev deployment's URL (packages/backend/.env.local after `convex dev`)
XOLACE_CONVEX_URL=
