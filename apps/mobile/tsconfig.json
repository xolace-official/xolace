{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    // `tsc --noEmit` reuses the last run's program: a no-change run takes a few
    // seconds instead of ~30. The cache sits in this worktree's own (gitignored)
    // node_modules; CI starts without it and runs cold.
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsconfig.tsbuildinfo",
    // app.config.ts imports release/production-guard.ts with its extension:
    // Expo's config loader only resolves a TS import written that way.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@/modules/*": ["./modules/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    // Read-only reference copies of other codebases. They are consulted, never
    // imported, and they do not typecheck against this project's config.
    "src/components/extras/sample-codes/**"
  ]
}
