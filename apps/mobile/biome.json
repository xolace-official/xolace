{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**", "!assets", "!src/uniwind-types.d.ts"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "vitest.setup.ts", "metro.config.js"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noForEach": "off",
            "noUselessLoneBlockStatements": "off",
            "noVoid": "off",
            "useOptionalChain": "off"
          },
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "noUnusedImports": "off",
            "noUnusedVariables": "off",
            "noVoidTypeReturn": "off",
            "useExhaustiveDependencies": "off"
          },
          "performance": {
            "noAwaitInLoops": "off",
            "noBarrelFile": "off",
            "noNamespaceImport": "off",
            "useTopLevelRegex": "off"
          },
          "style": {
            "noExportedImports": "off",
            "noIncrementDecrement": "off",
            "noNestedTernary": "off",
            "noNonNullAssertion": "off",
            "useAtIndex": "off",
            "useConsistentMethodSignatures": "off",
            "useConsistentTypeDefinitions": "off",
            "useDefaultSwitchClause": "off",
            "useDestructuring": "off",
            "useFilenamingConvention": "off",
            "useNodejsImportProtocol": "off",
            "useShorthandAssign": "off",
            "useTemplate": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noAssignInExpressions": "off",
            "noBitwiseOperators": "off",
            "noConfusingVoidType": "off",
            "noEmptyBlockStatements": "off",
            "noEqualsToNull": "off",
            "noEvolvingTypes": "off",
            "noExplicitAny": "off",
            "noGlobalAssign": "off",
            "noImplicitAnyLet": "off",
            "noLeakedRender": "off",
            "noNestedPromises": "off",
            "noRedeclare": "off",
            "noReturnAssign": "off",
            "noShadow": "off",
            "noShadowRestrictedNames": "off",
            "noUnnecessaryConditions": "off",
            "noUnusedExpressions": "off",
            "useAwait": "off",
            "useIterableCallbackReturn": "off"
          }
        }
      }
    },
    {
      "includes": ["src/themes/**/*.css", "src/global.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateCustomProperties": "off"
          }
        }
      }
    },
    {
      "includes": ["modules/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "useConsistentMethodSignatures": "off",
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/features/insights/{glass,trend-chip,detail-card,domain-list,overall-dial}.tsx"
      ],
      "assist": {
        "actions": {
          "source": {
            "useSortedAttributes": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "globals": ["__DEV__"]
  }
}
