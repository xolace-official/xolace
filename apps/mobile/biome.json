{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**", "!assets"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["themes/**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDuplicateCustomProperties": "off"
          }
        }
      }
    },
    {
      "includes": ["modules/**"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "useConsistentMethodSignatures": "off",
            "useFilenamingConvention": "off"
          }
        }
      }
    }
  ]
}
