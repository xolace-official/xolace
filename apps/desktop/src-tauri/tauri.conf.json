{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xolace",
  "version": "../package.json",
  "identifier": "com.xolaceincorg.xolace.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "bun --filter @xolace/web dev",
    "beforeBuildCommand": "bunx turbo run build --filter=@xolace/web"
  },
  "app": {
    "windows": [
      {
        "title": "Xolace",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
