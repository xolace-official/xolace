{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xolace",
  "version": "../package.json",
  "identifier": "com.xolaceincorg.xolace.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "bun --filter @xolace/web dev",
    "beforeBuildCommand": "bunx turbo run build --filter=@xolace/web"
  },
  "app": {
    "windows": [
      {
        "title": "Xolace",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": [
          "'self'",
          "https://curious-kingfish-86.clerk.accounts.dev",
          "https://clerk.xolaceinc.com",
          "https://challenges.cloudflare.com",
          "https://*.protect.clerk.com"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://*.convex.cloud",
          "wss://*.convex.cloud",
          "https://curious-kingfish-86.clerk.accounts.dev",
          "https://clerk.xolaceinc.com",
          "https://*.protect.clerk.com:*"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "data:",
          "blob:",
          "https://img.clerk.com"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "font-src": [
          "'self'",
          "data:"
        ],
        "frame-src": [
          "https://challenges.cloudflare.com",
          "https://*.protect.clerk.com"
        ],
        "worker-src": [
          "'self'",
          "blob:"
        ],
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": [
          "'self'",
          "http://localhost:3001"
        ],
        "script-src": [
          "'self'",
          "'unsafe-eval'",
          "'unsafe-inline'",
          "http://localhost:3001",
          "https://curious-kingfish-86.clerk.accounts.dev",
          "https://challenges.cloudflare.com",
          "https://*.protect.clerk.com"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://localhost:3001",
          "ws://localhost:3001",
          "https://*.convex.cloud",
          "wss://*.convex.cloud",
          "https://curious-kingfish-86.clerk.accounts.dev",
          "https://*.protect.clerk.com:*"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "http://localhost:3001",
          "data:",
          "blob:",
          "https://img.clerk.com"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "http://localhost:3001"
        ],
        "font-src": [
          "'self'",
          "data:",
          "http://localhost:3001"
        ],
        "frame-src": [
          "https://challenges.cloudflare.com",
          "https://*.protect.clerk.com"
        ],
        "worker-src": [
          "'self'",
          "blob:",
          "http://localhost:3001"
        ],
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/xolace-official/xolace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
