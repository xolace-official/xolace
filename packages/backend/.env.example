# Names only. `CONVEX_DEPLOYMENT` is written to .env.local by `bunx convex dev`;
# deployment env vars (Clerk issuer, model keys) are set with `bunx convex env set`.

# Deployment used by `bunx convex dev`
CONVEX_DEPLOYMENT=

CLERK_JWT_ISSUER_DOMAIN=

# Optional. Client ID of the Clerk OAuth app for the CLI and desktop; unset means
# only session JWTs are accepted. See docs/setup/oauth-clients.md.
CLERK_OAUTH_CLIENT_ID=

# Lets account deletion remove the Clerk user. Unset, those deletions wait in
# clerk_user_deletions. A dev instance's key deletes users shared with staging and
# other dev deployments. See docs/setup/staging.md.
CLERK_SECRET_KEY=

CONVEX_ENV="development"

# Live evals only (`bun run test:evals`); dropped from every other test run.
ANTHROPIC_API_KEY=

OPENAI_API_KEY=

# scripts/kindling/describe-music.ts only (Gemini listens to the music tracks).
GEMINI_API_KEY=
# Same script, with an OpenRouter model (`--model vendor/name`).
OPENROUTER_API_KEY=
