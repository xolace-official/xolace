{
  "name": "@xolace/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Xolace Convex backend: schema, functions and the generated client API.",
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    },
    "./convex/_generated/*": {
      "types": "./convex/_generated/*.d.ts",
      "default": "./convex/_generated/*.js"
    },
    "./convex/*": "./convex/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit -p convex && tsc --noEmit -p tsconfig.json",
    "codegen": "node scripts/codegen.mjs",
    "dev": "convex dev",
    "dev:setup": "convex dev --configure --until-success",
    "kindling:hashes": "node scripts/kindling/ingest.ts --update-hashes",
    "kindling:ingest": "node scripts/kindling/ingest.ts",
    "kindling:ingest:prod": "node scripts/kindling/ingest.ts --prod",
    "lint": "biome check . && eslint convex",
    "lint:convex": "eslint convex",
    "stream:setup": "convex run streamSetup:setup",
    "stream:setup:prod": "convex run --prod streamSetup:setup",
    "stream:webhook": "convex run streamWebhook:registerWebhook",
    "stream:webhook:prod": "convex run --prod streamWebhook:registerWebhook",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:evals": "RUN_EVALS=1 vitest run --testTimeout 30000 convex/ai/prompts/__evals__",
    "test:evals:intensity": "RUN_EVALS=1 vitest run --testTimeout 30000 convex/ai/prompts/__evals__/intensity.eval.test.ts",
    "test:evals:talk": "RUN_EVALS=1 vitest run --testTimeout 30000 convex/ai/prompts/__evals__/talk.eval.test.ts",
    "test:local": "node scripts/test-local.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.99",
    "@anthropic-ai/sdk": "0.92.0",
    "@clipin/convex-credits": "1.0.1",
    "@convex-dev/action-cache": "^0.3.1",
    "@convex-dev/aggregate": "^0.3.0",
    "@convex-dev/expo-push-notifications": "^0.3.1",
    "@convex-dev/migrations": "^0.3.6",
    "@convex-dev/presence": "^0.4.0",
    "@convex-dev/r2": "^0.10.2",
    "@convex-dev/rag": "^0.7.6",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workflow": "^0.4.6",
    "@posthog/convex": "^2.1.3",
    "ai": "catalog:",
    "convex": "catalog:",
    "convex-helpers": "^0.1.128",
    "convex-revenuecat": "^0.3.2"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.11",
    "@xolace/config": "workspace:*",
    "convex-test": "catalog:",
    "eslint": "^9.39.0",
    "sharp": "^0.35.5",
    "thumbhash": "^0.1.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.2.2",
    "vitest": "catalog:"
  }
}
